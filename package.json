{
  "name": "@libre-ai/pi-evidence",
  "version": "0.1.0",
  "description": "Pi Coding Agent package: run a repository's declared checks and record evidence bound to the revision, the recipe and the model identity, with a verdict that separates conformance from 'no problem detected'.",
  "license": "Apache-2.0",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "files": [
    "bin",
    "extensions",
    "src",
    "README.md",
    "LICENSES",
    "REUSE.toml",
    "docs/evidence.schema.json"
  ],
  "pi": {
    "extensions": [
      "./extensions/evidence.ts"
    ],
    "skills": [],
    "prompts": []
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@types/bun": "1.3.14",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "typescript": "7.0.2"
  },
  "scripts": {
    "lint": "biome ci .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test",
    "check:licenses": "reuse lint",
    "check:markers": "bun scripts/check-markers.ts",
    "pack": "bun pm pack --destination dist",
    "check": "bun run lint && bun run typecheck && bun test && bun run check:licenses && bun run check:markers"
  },
  "bin": {
    "evidence": "./bin/evidence.ts"
  }
}
